# Normalizacion de fin de linea.
# Los scripts de shell y el Maven Wrapper DEBEN conservar LF para poder
# ejecutarse en Linux/macOS despues de clonar desde Windows.
* text=auto

mvnw      text eol=lf
*.sh      text eol=lf

mvnw.cmd  text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.ps1     text eol=crlf

*.png     binary
*.jpg     binary
*.gif     binary
*.jar     binary
*.zip     binary
